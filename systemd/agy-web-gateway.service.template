[Unit]
Description=Antigravity WebUI Gateway
After=network.target agy-backend.service
PartOf=agy-backend.service

[Service]
Type=simple
WorkingDirectory=__PROJECT_ROOT__
EnvironmentFile=__PROJECT_ROOT__/config.env
ExecStart=__NODE_BIN__ __PROJECT_ROOT__/backend/server.mjs
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
