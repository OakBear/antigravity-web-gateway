# Antigravity Headless Backend & WebUI Gateway Configuration
# Copy this file to `config.env` and customize paths for your Linux environment.
# Note: systemd EnvironmentFile does not expand `$HOME`, so use absolute paths in `config.env`.

# Optional: restrict startup to a specific short hostname (`hostname -s`). Leave empty to allow any host.
AGY_ALLOWED_HOST=

# Dedicated WebUI Gateway bind address (pair with SSH tunnel: ssh -N -L 12689:127.0.0.1:13081 user@host)
AGY_WEB_HOST=127.0.0.1
AGY_WEB_PORT=13081

# Backend mode: standalone (direct language_server, recommended) | electron (Electron Ozone headless)
AGY_BACKEND_MODE=standalone

# Pinned HTTP port for language_server (0 = random; fixed port avoids collisions)
AGY_LS_HTTP_PORT=13082
AGY_BACKEND_HTTP_PORT=13082

# Dedicated headless profile root (isolated from desktop GUI profile)
AGY_PROFILE_ROOT=/home/youruser/.config/agy-headless
AGY_LS_LOG_PATH=/home/youruser/.config/agy-headless/Antigravity/logs/language_server.log
AGY_APP_STORAGE_PATH=/home/youruser/.config/agy-headless/Antigravity/app_storage.json

# Default workspace path suggested in WebUI folder picker
AGY_DEFAULT_WORKSPACE=/home/youruser/workspace

# Optional outbound HTTP/HTTPS proxy (leave empty for direct connection)
AGY_PROXY_URL=

# Runtime binaries (update to match your installed Node.js and Antigravity paths)
AGY_IDE_VERSION=2.28.1
AGY_NODE_BIN=/usr/bin/node
AGY_APP_ROOT=/home/youruser/.local/opt/antigravity-app/Antigravity-x64
AGY_ELECTRON_BIN=/home/youruser/.local/opt/antigravity-app/Antigravity-x64/antigravity
AGY_LS_BIN=/home/youruser/.local/opt/antigravity-app/Antigravity-x64/resources/bin/language_server
